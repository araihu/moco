# Nonsecret settings only. Keep all credential bytes in private mounted files.
MOCO_IMAGE=moco:REPLACE_WITH_RELEASE_COMMIT
MOCO_DATA_DIR=/srv/moco/data
MOCO_BACKUP_DIR=/srv/moco/backups
# Provision a mounted, access-controlled off-host filesystem before starting.
MOCO_MIRROR_DIR=/mnt/moco-offhost/archives
MOCO_MIRROR_ID=REPLACE_WITH_INIT_MIRROR_UUID
MOCO_CREDENTIALS_DIR=/etc/moco/credentials
MOCO_PUBLIC_BIND=0.0.0.0
MOCO_PUBLIC_PORT=8443
MOCO_ADMIN_PORT=9443
MOCO_ENCRYPTION_KEY_EPOCH=1
MOCO_BACKUP_KEEP=96
